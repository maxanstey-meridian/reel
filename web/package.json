{
  "name": "reel-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "preview": "nuxi preview",
    "lint": "oxlint app/ && eslint .",
    "lint:fix": "oxlint --fix app/ && eslint . --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "nuxi typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "rivet": "dotnet rivet --project ../server/Reel.Server/Reel.Server.csproj --output generated/rivet",
    "rivet:types": "openapi-typescript generated/rivet/openapi.json -o generated/rivet/schema.d.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^3.3.7",
    "nuxt": "^4.4.2",
    "openapi-fetch": "^0.17.0",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^3.23.0",
    "@parcel/watcher": "^2.5.6",
    "@playwright/test": "^1.59.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "eslint": "^10.2.0",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.59.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.8.0"
}
